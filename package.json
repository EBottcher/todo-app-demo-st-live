{
  "name": "todo-app-demo-st-live",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev:api": "dotnet run --project apps/api/src/TodoApp.Api/TodoApp.Api.csproj",
    "dev:web": "pnpm --filter @todo/web dev",
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "build:api": "dotnet build apps/api/TodoApp.sln -c Release",
    "build:web": "pnpm --filter @todo/web build",
    "build": "pnpm build:api && pnpm build:web",
    "test:api": "dotnet test apps/api/TodoApp.sln",
    "test": "pnpm test:api"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
